  (:version "2.1.0" :published "2022-03-06"
    :dependencies (("color" "^1.1.0") ("unicode" "~1.0.0")))
  (:version "2.0.0" :published "2021-12-31"
    :dependencies (("color" "^1.1.0") ("unicode" "^1.0.0")))
  (:version "1.1.0" :published "2021-07-26"
    :dependencies (("color" "^1.1.0") ("crc32" "^0.1.0") ("endian" "^1.1.0")))))
