(in-package #:spool/tests)
(in-suite :spool)

;;; The server, called in the same image, without the network.

(defparameter *one-worker* '(("work" :workers 1)))

(test submit-and-wait
  (with-server (server :port nil)
    (let ((id (spool:submit server "default" "echo" '("hello" "world"))))
      (is (equal '(:done "hello world")
                 (multiple-value-list (spool:wait-for-job server id :timeout 10))))
      (is (eq :done (spool:job-status server id))))
    (let ((id (spool:submit server "default" "checksum" '("Wikipedia"))))
      (is (equal '(:done "11e60398")
                 (multiple-value-list (spool:wait-for-job server id :timeout 10)))))
    (let ((id (spool:submit server "default" "count-words" '("It's a job, isn't it?"))))
      (is (equal '(:done "5")
                 (multiple-value-list (spool:wait-for-job server id :timeout 10)))))))

(test priorities
  (with-server (server :port nil :queues *one-worker*)
    (ran)
    (spool:pause-queue server "work")
    (let ((ids (loop for (name priority) in '(("a" 5) ("b" 1) ("c" 9) ("d" 5) ("e" 9) ("f" 0))
                     collect (spool:submit server "work" "record" (list name) :priority priority))))
      (is (equal '(:waiting 6 :running 0 :done 0 :failed 0 :cancelled 0)
                 (spool:queue-stats server "work")))
      (spool:resume-queue server "work")
      (dolist (id ids)
        (is (eq :done (spool:wait-for-job server id :timeout 10))))
      (is (equal '("c" "e" "a" "d" "b" "f") (ran))))))

(test cancel-waiting-jobs
  (with-server (server :port nil :queues *one-worker*)
    (ran)
    (spool:pause-queue server "work")
    (let ((ids (loop for name in '("a" "b" "c" "d" "e")
                     collect (spool:submit server "work" "record" (list name)))))
      (is (eq :cancelled (spool:cancel-job server (second ids))))
      (is (eq :cancelled (spool:cancel-job server (fifth ids))))
      (signals spool-error (spool:cancel-job server (second ids)))
      (is (eq :cancelled (spool:job-status server (second ids))))
      (is (equal '(:waiting 3 :running 0 :done 0 :failed 0 :cancelled 2)
                 (spool:queue-stats server "work")))
      (spool:resume-queue server "work")
      (dolist (id ids)
        (spool:wait-for-job server id :timeout 10))
      (is (equal '("a" "c" "d") (ran)))
      (is (eq :cancelled (spool:wait-for-job server (fifth ids) :timeout 10)))
      (is (equal '(:waiting 0 :running 0 :done 3 :failed 0 :cancelled 2)
                 (spool:queue-stats server "work"))))))

(test running-jobs-cannot-be-cancelled
  (with-server (server :port nil :queues *one-worker*)
    (let ((id (spool:submit server "work" "sleep" '("0.5"))))
      (is (wait-until (lambda () (eq :running (spool:job-status server id)))))
      (signals spool-error (spool:cancel-job server id))
      (is (equal '(:done "slept 0.5")
                 (multiple-value-list (spool:wait-for-job server id :timeout 10))))
      (signals spool-error (spool:cancel-job server id)))))

(test wait-times-out
  (with-server (server :port nil :queues *one-worker*)
    (let ((id (spool:submit server "work" "sleep" '("1"))))
      (is (eq :timeout (spool:wait-for-job server id :timeout 0.1)))
      (is (eq :done (spool:wait-for-job server id :timeout 10))))))

(test retries
  (clrhash *flaky-tries*)
  (with-server (server :port nil :queues *one-worker*)
    (let ((patient (spool:submit server "work" "flaky" '("patient" "2") :attempts 3))
          (hasty (spool:submit server "work" "flaky" '("hasty" "1"))))
      (is (equal '(:done "patient after 3 tries")
                 (multiple-value-list (spool:wait-for-job server patient :timeout 10))))
      (is (equal '(:failed "try 1 of hasty failed")
                 (multiple-value-list (spool:wait-for-job server hasty :timeout 10))))
      (is (equal '(:waiting 0 :running 0 :done 1 :failed 1 :cancelled 0)
                 (spool:queue-stats server "work")))
      (is (eq :queued (spool:retry-job server hasty)))
      (is (equal '(:done "hasty after 2 tries")
                 (multiple-value-list (spool:wait-for-job server hasty :timeout 10))))
      (signals spool-error (spool:retry-job server hasty))
      (is (equal '(:waiting 0 :running 0 :done 2 :failed 0 :cancelled 0)
                 (spool:queue-stats server "work"))))))

(test crashing-jobs-fail
  (with-server (server :port nil :queues *one-worker*)
    (let ((crash (spool:submit server "work" "crash" '()))
          (after (spool:submit server "work" "echo" '("still" "working")))
          (wrong (spool:submit server "work" "checksum" '("one" "too many"))))
      (is (equal '(:failed "the job crashed")
                 (multiple-value-list (spool:wait-for-job server crash :timeout 10))))
      (is (equal '(:done "still working")
                 (multiple-value-list (spool:wait-for-job server after :timeout 10))))
      (is (eq :failed (spool:wait-for-job server wrong :timeout 10))))))

(test bad-requests
  (with-server (server :port nil)
    (signals spool-error (spool:submit server "nowhere" "echo" '()))
    (signals spool-error (spool:submit server "default" "teleport" '()))
    (signals spool-error (spool:submit server "default" "echo" '() :priority 10))
    (signals spool-error (spool:submit server "default" "echo" '() :attempts 0))
    (signals spool-error (spool:job-status server 999))
    (signals spool-error (spool:pause-queue server "nowhere"))
    (is (equal '("default") (spool:server-queue-names server)))))
